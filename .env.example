# Required
GOOGLE_API_KEY=your_google_api_key_here

# Infrastructure (defaults match a local `docker compose up`)
MONGODB_URI=mongodb://localhost:27017
QDRANT_URL=http://localhost:6333
# Only needed for Qdrant Cloud
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379

# Optional
GEMINI_MODEL=gemini-2.5-flash
# sync  = index the PDF inside the /upload request (works on hosts without a worker, e.g. Render free tier)
# queue = enqueue to Redis/RQ and return a job_id (requires `python -m secondbrain.queues.worker`)
UPLOAD_MODE=sync
