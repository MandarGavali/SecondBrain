GOOGLE_API_KEY=your_google_api_key_here
MONGODB_URI=mongodb://localhost:27017
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
QDRANT_API_KEY=your_qdrant_api_key_here
# ---- Research extensions (defaults shown) ----
# GRAPH_MODE=adaptive         # adaptive (default) | agent (legacy)
# FORCE_ROUTE=                # no_search | simple | complex
# ENABLE_ROUTER=1
# ROUTER_MODE=hybrid          # heuristic | llm | hybrid
# ENABLE_LOMCP=1
# ENABLE_VERIFY=1
# VERIFY_SIMPLE_LLM=0
# ENABLE_AAM=1
# AAM_MODE=background         # background | queue | inline
# QUALITY_ENABLED=1
